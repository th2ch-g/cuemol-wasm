get_filename_component(CUEMOL_WASM_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
list(APPEND CMAKE_MODULE_PATH "${CUEMOL_WASM_ROOT}/cmake")
set(CMAKE_POLICY_VERSION_MINIMUM 3.5 CACHE STRING "" FORCE)
set(CMAKE_DISABLE_FIND_PACKAGE_OpenGL TRUE)
set(CMAKE_DISABLE_FIND_PACKAGE_GLEW TRUE)
set(LIBLZMA_INCLUDE_DIR "${CUEMOL_WASM_ROOT}/.cache/xz/include" CACHE PATH "" FORCE)
set(LIBLZMA_LIBRARY "${CUEMOL_WASM_ROOT}/.cache/xz/lib/liblzma.a" CACHE FILEPATH "" FORCE)
set(CMAKE_DISABLE_FIND_PACKAGE_XMLRPC TRUE)
set(LCMS2_INCLUDE_DIR "${CUEMOL_WASM_ROOT}/.cache/lcms/include" CACHE PATH "" FORCE)
set(LCMS2_LIBRARIES "${CUEMOL_WASM_ROOT}/.cache/lcms/lib/liblcms2.a" CACHE FILEPATH "" FORCE)
set(FFTW_INCLUDE_DIR "${CUEMOL_WASM_ROOT}/.cache/fftw/include" CACHE PATH "" FORCE)
set(FFTW_LIBRARIES "${CUEMOL_WASM_ROOT}/.cache/fftw/lib/libfftw3f.a" CACHE FILEPATH "" FORCE)
set(TBB_DIR "${CUEMOL_WASM_ROOT}/.cache/tbb/lib/cmake/TBB" CACHE PATH "" FORCE)
set(embree_DIR "${CUEMOL_WASM_ROOT}/.cache/embree/lib/cmake/embree-4.4.1" CACHE PATH "" FORCE)
set(umbreon_DIR "${CUEMOL_WASM_ROOT}/.cache/umbreon-install/lib/cmake/umbreon" CACHE PATH "" FORCE)
set(ENABLE_TBB OFF CACHE BOOL "" FORCE)
set(ENABLE_UMBREON ON CACHE BOOL "" FORCE)
set(ENABLE_MESHMS OFF CACHE BOOL "" FORCE)
set(ENABLE_PYTHON_EMBED OFF CACHE BOOL "" FORCE)
set(BUILD_NODEJS_BINDINGS ON CACHE BOOL "" FORCE)
set(ENABLE_TYPESCRIPT ON CACHE BOOL "" FORCE)
set(BUILD_PYTHON_BINDINGS OFF CACHE BOOL "" FORCE)
set(BUILD_XPCJS_BINDINGS OFF CACHE BOOL "" FORCE)
add_compile_options(-pthread -fexceptions)
add_compile_definitions(NAPI_CPP_EXCEPTIONS=1)
add_subdirectory("${CUEMOL_WASM_ROOT}/node_modules/emnapi" "${CMAKE_BINARY_DIR}/emnapi")
cmake_language(DEFER CALL include "${CUEMOL_WASM_ROOT}/cmake/finalize.cmake")
